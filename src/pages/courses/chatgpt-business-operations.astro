---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = "/courses/chatgpt-business-operations";
const d2 = `${base}/day-2`;
const labs = [
  ["lab-1-1-rewrite-your-prompts", "Lab 1.1: Rewrite your prompts"],
  ["lab-1-2-documents-and-pdfs", "Lab 1.2: Documents and PDFs"],
  ["lab-1-3-word-and-excel", "Lab 1.3: Word and Excel"],
  ["lab-1-4-research-and-verification", "Lab 1.4: Research and verification"],
  ["lab-1-5-your-first-project", "Lab 1.5: Your first Project"],
];
const handouts = [
  ["workflow-card.pdf", "Workflow card (PDF)"],
  ["prompt-library-template.docx", "Prompt library template (Word)"],
  ["ai-use-policy-draft.docx", "AI use policy: draft for your company to decide (Word)"],
];
const samples = [
  ["day1-weak-prompts.pdf", "Weak prompts for Lab 1.1 (PDF)"],
  ["day1-contract-extract.pdf", "Synthetic subcontract extract for Lab 1.2 (PDF)"],
  ["day1-plant-log.csv", "Plant log for Lab 1.3 (CSV, opens in Excel)"],
];
const labs2 = [
  ["lab-2-1-pqq-answer-skill", "Lab 2.1: PQQ answer skill"],
  ["lab-2-2-tender-compliance-skill", "Lab 2.2: Tender compliance skill"],
  ["lab-2-3-project-case-study", "Lab 2.3: Project case study"],
  ["lab-2-4-method-statements", "Lab 2.4: Method statements"],
  ["lab-2-5-risk-assessments-and-toolbox-talks", "Lab 2.5: Risk assessments and toolbox talks"],
  ["lab-2-6-quality-and-environmental", "Lab 2.6: Quality and environmental"],
  ["lab-2-7-department-projects", "Lab 2.7: Department Projects"],
  ["lab-2-8-package-your-skills", "Lab 2.8: Package your skills"],
];
const handouts2 = [
  ["build-a-skill-worksheet.pdf", "Worksheet: build a skill with your team (PDF)"],
  ["skill-template.docx", "Skill template (Word)"],
  ["workflow-card.pdf", "Workflow card (PDF)"],
];
const samples2 = [
  ["day2-pqq-questions.pdf", "Sample PQQ questions for Lab 2.1 (PDF)"],
  ["day2-tender-extract.pdf", "Invented tender extract for Lab 2.2 (PDF)"],
  ["day2-project-notes.pdf", "Project notes for Lab 2.3 (PDF)"],
  ["day2-site-scenario.pdf", "Site scenario for Labs 2.4 and 2.5 (PDF)"],
  ["day2-quality-environment.pdf", "Quality and environment notes for Lab 2.6 (PDF)"],
];
---

<BaseLayout
  pageTitle="ChatGPT for Business Operations (course materials)"
  pageDescription="Labs, handouts and sample files for delegates on the ChatGPT for Business Operations course."
  showSocials={false}
  noindex={true}
>
  <article class="course-page">
    <header>
      <h1>ChatGPT for Business Operations</h1>
      <p class="course-tagline">Course materials for delegates</p>
    </header>

    <section class="downloads-section" id="materials">
      <h2>Course materials</h2>
      <p>
        Materials are grouped by day. The labs are PDFs, so you can
        read them on any device or print them. The two templates are Word files
        you can edit. All sample files are invented for training and are not
        for use on any project.
      </p>

      <h3>Download everything</h3>
      <ul class="downloads-list">
        <li>
          <a href={`${base}/chatgpt-day-1-materials.zip`} download><strong>All Day 1 materials (zip)</strong></a>
          : the five labs, three handouts and three sample files.
        </li>
        <li>
          <a href={`${base}/chatgpt-day-2-materials.zip`} download><strong>All Day 2 materials (zip)</strong></a>
          : the eight labs, the skill-building worksheet, the skill template, the workflow card and five sample files.
        </li>
      </ul>

      <h2>Day 1: AI fundamentals</h2>

      <h3>Labs</h3>
      <ul class="downloads-list">
        {labs.map(([file, label]) => (
          <li><a href={`${base}/labs/${file}.pdf`} download>{label}</a></li>
        ))}
      </ul>

      <h3>Handouts</h3>
      <ul class="downloads-list">
        {handouts.map(([file, label]) => (
          <li><a href={`${base}/handouts/${file}`} download>{label}</a></li>
        ))}
      </ul>

      <h3>Sample files</h3>
      <ul class="downloads-list">
        {samples.map(([file, label]) => (
          <li><a href={`${base}/samples/${file}`} download>{label}</a></li>
        ))}
      </ul>
      <h2>Day 2: skills, plugins and tendering and safety</h2>

      <h3>Labs</h3>
      <ul class="downloads-list">
        {labs2.map(([file, label]) => (
          <li><a href={`${d2}/labs/${file}.pdf`} download>{label}</a></li>
        ))}
      </ul>

      <h3>Handouts</h3>
      <ul class="downloads-list">
        {handouts2.map(([file, label]) => (
          <li><a href={`${d2}/handouts/${file}`} download>{label}</a></li>
        ))}
      </ul>

      <h3>Sample files</h3>
      <ul class="downloads-list">
        {samples2.map(([file, label]) => (
          <li><a href={`${d2}/samples/${file}`} download>{label}</a></li>
        ))}
      </ul>
      <h3>Inspiration: published skills</h3>
      <p>
        Three public collections of skills for construction and tendering work.
        They are written for developer tools such as Claude Code, so read them
        for ideas and structure rather than installing them. They are written by
        other people and I have not tested them. Read any skill carefully before
        you use it, and keep anything confidential out of it.
      </p>
      <ul class="downloads-list">
        <li>
          <a href="https://github.com/dgcruzing/construction-office-skills" target="_blank" rel="noopener noreferrer">Construction office skills</a>
          : meeting minutes and actions, RFI drafter, daily site diary, variation and extension of time draft, non-conformance reports, tender comparison matrix.
        </li>
        <li>
          <a href="https://github.com/dleerdefi/claude-code-construction" target="_blank" rel="noopener noreferrer">Claude Code construction skills</a>
          : bid tabulator and evaluator, submittal log, schedule extractor, subcontract writer.
        </li>
        <li>
          <a href="https://github.com/peterbamuhigire/proposal-skills" target="_blank" rel="noopener noreferrer">Proposal skills</a>
          : tender and expression of interest writing, including methodology, work plan and evaluator storytelling. No licence is stated, so use it for inspiration only.
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>
