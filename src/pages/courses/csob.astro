---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = "/courses/csob";
const feedbackUrl =
  "https://forms.cloud.microsoft/Pages/ResponsePage.aspx?id=e_W03kuia0Of7lReNqN5xj8zt_gN5ypBgnaPclXpL19UQ1ZQNThEUzFWSlhKT0xHVERWS1I4VjE1RC4u";
const days = [
  {
    day: "Day 1",
    title: "Foundations of Agentic Logic",
    slides: `${base}/slides/day-1-foundations-of-agentic-logic.pdf`,
    worksheets: [
      ["autonomy-spectrum-memory-tiers-worksheet", "Autonomy spectrum and memory tiers worksheet"],
      ["case-study-1-mortgage-pre-screening-assistant", "Case study 1: the mortgage pre-screening assistant"],
      ["case-study-2-compliance-policy-copilot", "Case study 2: the compliance-policy Q&A copilot"],
      ["terminology-glossary", "Terminology glossary"],
      ["compaction-exercise-cs", "Conversation compaction exercise (in Czech)"],
    ],
  },
  {
    day: "Day 2",
    title: "Architectural Patterns and Protocols",
    slides: `${base}/slides/day-2-architectural-patterns-and-protocols.pdf`,
    worksheets: [
      ["architecture-review-worksheet", "Architecture review worksheet"],
      ["day2-incident-cards", "Incident cards: five real agent incidents"],
      ["day2-card-pack", "Card pack: vote cards, sort cards, sort mat and workshop roles"],
      ["day2-paper-agents-kit", "Paper agents kit: roles, forms and complaints"],
      ["day2-approval-board-packs", "MCP approval board: checklist, decision card and proposal packs"],
    ],
  },
  {
    day: "Day 3",
    title: "Distributed Systems and Reliability",
    slides: `${base}/slides/day-3-distributed-systems-and-reliability.pdf`,
    worksheets: [
      ["day3-incident-cards", "Incident cards: five more real agent incidents"],
      ["day3-knight-timeline-and-retry-ledger", "Knight Capital timeline strips and retry ledger"],
      ["day3-night-log-and-config-diff", "Night log and configuration diff"],
      ["day3-layers-and-escalation-pack", "Layers mat and escalation trigger pack"],
      ["day3-tabletop-kit", "Tabletop kit: a customer-facing agent"],
      ["agent-configuration-record-template", "Agent configuration record template"],
      ["day3-where-this-lives", "Where this lives in the real world: tools, standards and questions to ask"],
    ],
    extras: [
      ["code/day3-demos.zip", "Demo source code (all five demos, zipped)"],
      ["code/day3-exhibits.zip", "Day 3 exhibits: retry, config diff, output schema, tool policy, trigger (code, zipped)"],
    ],
  },
  {
    day: "Day 4",
    title: "Governance, Evaluation and Ops",
    slides: `${base}/slides/day-4-governance-evaluation-and-ops.pdf`,
    worksheets: [
      ["fifteen-incidents-days-2-to-4", "All fifteen real incidents from Days 2 to 4 in one PDF"],
      ["day4/00-incident-cards-day4", "Incident cards: five more real incidents (Day 4)"],
      ["day4/01-Q-which-rule-does-this-touch", "01 Q: Which rule does this touch? (sheet)"],
      ["day4/01-Q-the-four-cards", "01 Q: The four cards (Samsung, Italy, Air Canada, postmark-mcp)"],
      ["day4/01-Q-rules-reference", "01 Q: The rules banks already work under (reference)"],
      ["day4/02-D-follow-the-data", "02 D: Follow one customer's data"],
      ["day4/03-C-which-risk-class", "03 C: Which risk class?"],
      ["day4/04-B-case-eleven-days-without-a-cap", "04 B: Case card, eleven days without a cap"],
      ["day4/04-B-the-bill-arrived", "04 B: The bill arrived (ledger and budget rule)"],
      ["day4/05-T-tag-it-and-route-it", "05 T: Tag it and route it"],
      ["day4/06-W-the-wall-against-the-matrix", "06 W: The wall against the matrix (A3)"],
      ["day4/07-N-what-would-you-have-seen-at-0200", "07 N: What would you have seen at 02:00?"],
      ["day4/08-F-fail-on-purpose", "08 F: Fail on purpose"],
      ["day4/09-S-score-the-guardrail", "09 S: Score the guardrail"],
      ["day4/09-S-count-then-turn-the-dial", "09 S: Count, then turn the dial"],
      ["day4/10-G-case-amazon-q-developer", "10 G: Case card, Amazon Q Developer"],
      ["day4/11-R-review-board-pack-and-decision-sheet", "11 R: Review board pack and committee decision sheet (A3 and A4)"],
      ["day4/12-A-case-deloitte-australia", "12 A: Case card, Deloitte Australia"],
      ["day4/12-A-the-review-that-came-back-clean", "12 A: The review that came back clean"],
      ["day4/13-M-six-vendor-questions-and-the-match", "13 M: Six vendor questions and the match"],
      ["day4/14-O-take-away-where-this-lives", "14 O: Where this lives in the real world (take-away)"],
    ],
  },
];
---

<BaseLayout
  pageTitle="Enterprise Agentic Systems: Foundations (course materials)"
  pageDescription="Slides and worksheets for delegates on the Enterprise Agentic Systems: Foundations course."
  showSocials={false}
  noindex={true}
>
  <article class="course-page">
    <header>
      <h1>Enterprise Agentic Systems: Foundations</h1>
      <p class="course-tagline">Course materials for delegates</p>
    </header>

    <section class="downloads-section" id="feedback">
      <h2>Your feedback</h2>
      <p>
        Please take a few minutes to tell Framework Training and me what worked
        and what didn't. It is a short Microsoft form.
      </p>
      <p>
        <a href={feedbackUrl} target="_blank" rel="noopener noreferrer"><strong>Open the feedback form</strong></a>
      </p>
    </section>

    <section class="downloads-section" id="tools">
      <h2>Tools to put this into practice</h2>
      <p>
        A four-page guide to the tools that help you implement, monitor and
        enforce what we covered: tracing and cost monitoring, guardrails and
        gateways, testing and red teaming, and a map from the twelve controls
        on the Day 4 wall to the tools that support them.
      </p>
      <p>
        <a href={`${base}/agent-tooling-guide.pdf`} download><strong>Download the tooling guide (PDF)</strong></a>
      </p>
    </section>

    <section class="downloads-section" id="materials">
      <h2>Course materials</h2>
      <p>
        Slides and worksheets are grouped by day. Most files are PDFs, so you
        can read them on any device or print the worksheets for the workshop
        sessions. A couple of items are zipped source code instead.
      </p>

      <h3>Download everything</h3>
      <ul class="downloads-list">
        <li>
          <a href={`${base}/csob-course-materials.zip`} download><strong>All slides and handouts (zip)</strong></a>
          : the slides for all four days, every worksheet and card pack, and the tooling guide, as PDFs.
        </li>
        <li>
          <a href={`${base}/csob-course-code.zip`} download><strong>All code shown on the course (zip)</strong></a>
          : the five demos, the Day 1 vocabulary app and the Day 3 and Day 4 exhibits. The demos that call a model need your own API key (see each README).
        </li>
      </ul>

      {days.map((d) => (
        <>
          <h3>{d.day}: {d.title}</h3>
          <ul class="downloads-list">
            <li>
              <a href={d.slides} download><strong>Slides</strong></a>
            </li>
            {d.worksheets.map(([file, label]) => (
              <li>
                <a href={`${base}/worksheets/${file}.pdf`} download>{label}</a>
              </li>
            ))}
            {(d.extras ?? []).map(([file, label]) => (
              <li>
                <a href={`${base}/${file}`} download>{label}</a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>
  </article>
</BaseLayout>
